{
  "name": "crypto-arbitrage",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start:dev": "NODE_ENV=dev && npx nodemon",
    "start:dev:windows": "SET NODE_ENV=dev npx nodemon",
    "build": "rimraf ./build && tsc",
