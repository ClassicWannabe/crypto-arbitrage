{
  "name": "crypto-arbitrage",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aws-cdk": "bin/aws-cdk.js"
  },
  "scripts": {
    "start:dev": "npm-run-all --parallel start:prod local:db",
    "start:prod": "npm run build && forever build/index.js",
    "local:db": "sudo docker compose up",
    "build": "rimraf ./build && tsc",
    "test": "vitest",
    "script:arbitrage:prod": "npm run build && node build/scripts/runArbitrageFinderService.js",
    "script:arbitrage:dev": "tsx watch src/scripts/runArbitrageFinderService.ts",
    "deploy": "npx cdk deploy",
    "destroy": "npx cdk destroy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.506.0",
    "@aws-sdk/lib-dynamodb": "^3.506.0",
    "@prisma/client": "^5.8.1",
    "aws-cdk-lib": "^2.121.1",
    "ccxt": "^4.2.10",
    "constructs": "^10.3.0",
    "deepmerge-ts": "^5.1.0",
    "dotenv": "^16.3.1",
    "electrodb": "^2.13.1",
    "forever": "^4.0.3",
    "forever-monitor": "^3.0.3",
    "lodash-es": "^4.17.21",
    "node-html-to-image": "^4.0.0",
    "node-telegram-bot-api": "^0.64.0",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "winston": "^3.11.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/forever-monitor": "^1.7.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.10.6",
    "@types/node-telegram-bot-api": "^0.64.2",
    "aws-cdk": "^2.121.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "prisma": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "npm": ">=10",
    "node": "20.x",
    "yarn": "please use npm"
  }
}
