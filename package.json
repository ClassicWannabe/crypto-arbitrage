    "generate-gql-types": "graphql-codegen"
  },
  "dependencies": {
    "@apollo/client": "^3.8.8",
    "ccxt": "^4.2.10",
    "dotenv": "^16.3.1",
    "graphql": "^16.8.1",
    "lodash": "^4.17.21",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "npm": "please-use-yarn",
    "node": ">=20.0.0 <21.0.0",
    "yarn": ">=1.22.0 < 3.0.0"
  }
