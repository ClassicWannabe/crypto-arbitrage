<!DOCTYPE html>
<html>
<head>
<style>
table {
  font-family: arial, sans-serif;
  border-collapse: collapse;
  width: 49%;
}

.bids td {
    color: green
}

.asks td {
    color: red
}

td, th {
  border: 1px solid #dddddd;
  text-align: left;
  padding: 8px;
}

th {
    text-transform: uppercase;
    text-align: center;
}

tr:nth-child(even) {
  background-color: #dddddd;
}

body {
    display: flex;
    justify-content: space-between;
}
</style>
</head>
<body>

{{#each steps}}
    <table>
    <tr>
        <th colspan="2">{{this.exchangeId}}</th>
    </tr>
    <tr>
        <td>Price</td>
        <td>Amount</td>
    </tr>
    {{#each this.orderBook.asks}}
        <tr class="asks">
            {{#each this}}
                <td>{{this}}</td>
            {{/each}}
        </tr>
    {{/each}}
    {{#each this.orderBook.bids}}
        <tr class="bids">
            {{#each this}}
                <td>{{this}}</td>
            {{/each}}
        </tr>
    {{/each}}
    </table>
 {{/each}}

</body>
</html>