<!DOCTYPE html>
<html>
<head>
<style>
table {
  font-family: arial, sans-serif;
  border-collapse: collapse;
  width: 49%;
}

.bids td {
    color: green
}

.bids .used {
    color: rgb(0, 71, 0)
}

.asks td {
    color: red
}

.asks .used {
    color: rgb(102, 4, 4)
}

td, th {
  border: 1px solid #dddddd;
  text-align: left;
  padding: 8px;
}

th {
    text-transform: uppercase;
    text-align: center;
}

tr:nth-child(even) {
  background-color: #dddddd;
}

body {
    display: flex;
    justify-content: space-between;
}
</style>
</head>
<body>

{{#each steps}}
    <table>
    <tr>
        <th colspan="2">{{this.exchangeId}}</th>
    </tr>
    <tr>
        <td>Price</td>
        <td>Amount</td>
    </tr>
    {{#each this.orderBook.asks}}
        <tr class="asks">
            {{#if this.isUsed}}
                <td class="used"><b>{{this.quote}}</b></td>
                <td class="used"><b>{{this.base}}</b></td>
            {{else}}
                <td>{{this.quote}}</td>
                <td>{{this.base}}</td>
            {{/if}}
        </tr>
    {{/each}}
    {{#each this.orderBook.bids}}
        <tr class="bids">
            {{#if this.isUsed}}
                <td class="used"><b>{{this.quote}}</b></td>
                <td class="used"><b>{{this.base}}</b></td>
            {{else}}
                <td>{{this.quote}}</td>
                <td>{{this.base}}</td>
            {{/if}}
        </tr>
    {{/each}}
    </table>
 {{/each}}

</body>
</html>