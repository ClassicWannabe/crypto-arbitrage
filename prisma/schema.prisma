generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

model ArbitrageData {
  id               String          @id @default(uuid())
  symbol           String
  baseCurrency     String
  quoteCurrency    String
  status           ArbitrageStatus @default(UNTOUCHED)
  confirmationCode Int             @db.UnsignedInt
  isConfirmed      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  arbitrageSteps   ArbitrageStep[]
}

model ArbitrageStep {
  id              String            @id @default(uuid())
  arbitrageData   ArbitrageData     @relation(fields: [arbitrageDataId], references: [id], onDelete: Cascade)
  arbitrageDataId String
  order           Int               @db.UnsignedTinyInt
  type            ArbitrageStepType
  status          ArbitrageStatus   @default(UNTOUCHED)
  details         Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([arbitrageDataId, order])
}

enum ArbitrageStatus {
  PROCESSED
  PROCESSING
  UNTOUCHED
  FAILED
  CANCELLED
  EXPIRED
}

enum ArbitrageStepType {
  TRADE
  WITHDRAW
}
